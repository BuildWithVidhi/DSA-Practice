Using Hashet or Hashmap since they do not allow duplicates and only allow unique elements

class Solution{
public:
  bool ContainsDuplicate(vector<int>& nums)
  {
    unordered_set<int>seenNum;
    for(int num: nums)
    {
      if(seenNum.count(num)>0)
        return true
      seenNum.insert(num)
    }
return false
  }
};

class Solution{
public:
  bool ContainsDuplicate(vector<int>&nums)
  {
    unordered_map<int,int> seenNum;
    for(int num: nums)
    {
      if(seenNum.count(num) >=1)
        return true
      seenNum[num]++
    }
  return false;
  }
};
