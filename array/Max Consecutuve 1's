class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int consec=0;
        int ans=0;
        for(int i=0; i< nums.size();i++)
        {
            if(nums[i] == 1)
            {
                consec = consec + 1;
                if(consec > ans)
                {
                    ans = consec;
                }
            }
            else
            {
                consec = 0;
            }
        }
        return ans;
        
    }
};
