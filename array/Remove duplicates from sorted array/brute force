
class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        vector<int> unique;

        for(int i = 0; i < nums.size(); i++) {
            bool found = false;

            // Check if nums[i] is already present in unique
            for(int j = 0; j < unique.size(); j++) {
                if(unique[j] == nums[i]) {
                    found = true;
                    break;
                }
            }

            // If not found, add it
            if(!found) {
                unique.push_back(nums[i]);
            }
        }

        // Copy unique elements back into nums
        for(int i = 0; i < unique.size(); i++) {
            nums[i] = unique[i];
        }

        return unique.size();
    }
};
