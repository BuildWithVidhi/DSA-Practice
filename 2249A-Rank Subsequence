#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int n;
        cin >> n;

        vector<int> l(n + 1), r(n + 1), u(n + 1), v(n + 1);

        for (int i = 1; i <= n; i++)
            cin >> l[i] >> r[i] >> u[i] >> v[i];

        int ans = 0;

        for (int m = n; m >= 0; m--) {

            int need = 1;

            for (int i = 1; i <= n && need <= m; i++) {

                bool left_ok = !(l[i] <= need && need <= r[i]);

                int rightRank = m - need + 1;
                bool right_ok = !(u[i] <= rightRank && rightRank <= v[i]);

                if (left_ok && right_ok)
                    need++;
            }

            if (need == m + 1) {
                ans = m;
                break;
            }
        }

        cout << ans << "\n";
    }

    return 0;
}
