class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int n = nums.size();
        int i=n-2;
        while(i>=0)
        {
            if(nums[i]<nums[i+1])
            {
                break; //found the pivot
            }
            i--;
        }
        int j=n-1;
        while(j>=0 && i>=0)
        {
            if(nums[i]<nums[j])
            {
                swap(nums[i],nums[j]);
                break;//found next greater element
            }
            j--;
        }

        
        reverse(nums.begin()+i+1,nums.end());
    }
};
