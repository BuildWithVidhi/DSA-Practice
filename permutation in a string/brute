class Solution {
public:
    bool checkInclusion(string s1, string s2) {

        int k = s1.length();

        if(k > s2.length())
            return false;

        vector<int> freq1(26,0);

        for(char c : s1)
            freq1[c-'a']++;

        for(int i=0;i<=s2.length()-k;i++)
        {
            vector<int> freq2(26,0);

            for(int j=i;j<i+k;j++)
            {
                freq2[s2[j]-'a']++;
            }

            if(freq1==freq2)
                return true;
        }

        return false;
    }
};
