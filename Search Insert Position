class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int low = 0;
        int high = nums.size()-1;
        int mid = 0;
        int flag = 0;

        while(low<=high)
        {
            flag = 0;
            mid = low + (high - low)/2;
            if(nums[mid] == target)
            {
                return mid;
            }
            if(nums[mid] > target)
            {
                high = mid - 1;
                flag = 1;
            }
            else
            {
                low = mid + 1;
                flag = 1;
            }
        }
        if(flag == 1)
        {
            return low;
        }
    return -1;
    }
};
