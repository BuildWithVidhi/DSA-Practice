class Solution {
public:
    int bestClosingTime(string customers) {
     n = customers.size();
    int penalty = 0;

    //if shop is closed at all times
    for( char c: customers)
    {
      if( c == 'Y')
        penalty++;
    }

    int min_penalty = penalty;
    best_hour = 0;

    for( j =0; j<n; ++j)
  {
      if(customers[j] == 'Y')
      {  penalty--; }
      else
      { penalty++;}

      if(penalty < min_penalty)
      {
        min_penalty = penalty;
        best_hour = j + 1; // we are basically calculating the closing time here ki till here we can close
      }
  }

return penalty;
  
}
};
