class Solution {
public:
    int countOccurrences(vector<int>& arr, int target) {

    int left= solve(1,arr, target);
    if(left == -1)
        return 0;
    int right = solve(0,arr,target);

    return (right - left + 1);
        
    }

    int solve(int n,vector<int>arr, int target)
    {
        int low =0;
        int high = arr.size()-1;
        int mid=0;
        int pos=-1;

        while(low<=high)
        {
            mid = low + (high-low)/2;
            if(arr[mid] == target)
            {
                pos = mid;
                if(n==1)
                {
                    high = mid-1;
                }
                else{
                    low = mid+1;
                }
            }
            else if(arr[mid] > target)
            {
                high = mid-1;
            }
            else{
                low = mid + 1;
            }
        }
        return pos;
    }
};
