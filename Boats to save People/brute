class Solution {
public:
    int numRescueBoats(vector<int>& people, int limit) {

        sort(people.begin(), people.end());

        int n = people.size();

        vector<bool> used(n,false);

        int boats = 0;

        for(int i=n-1;i>=0;i--)
        {
            if(used[i])
                continue;

            used[i]=true;

            for(int j=0;j<i;j++)
            {
                if(!used[j] && people[i]+people[j]<=limit)
                {
                    used[j]=true;
                    break;
                }
            }

            boats++;
        }

        return boats;
    }
};
