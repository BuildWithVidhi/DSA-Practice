class Solution {
public:
    void sortColors(vector<int>& nums) {

        int zero = 0;
        int one = 0;
        int two = 0;

        // Count
        for(int i = 0; i < nums.size(); i++)
        {
            if(nums[i] == 0)
                zero++;

            else if(nums[i] == 1)
                one++;

            else
                two++;
        }

        int index = 0;

        // Fill 0s
        while(zero--)
        {
            nums[index] = 0;
            index++;
        }

        // Fill 1s
        while(one--)
        {
            nums[index] = 1;
            index++;
        }

        // Fill 2s
        while(two--)
        {
            nums[index] = 2;
            index++;
        }
    }
};
